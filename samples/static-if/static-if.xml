<?xml version="1.0"?>
<DCAPP>
    <!-- Parse-time configuration constants -->
    <Constant Name="DEBUG_MODE">1</Constant>
    <Constant Name="PRODUCTION_MODE">0</Constant>

    <!-- Runtime variables -->
    <Variable Type="#_variable_double_" InitialValue="0">COUNTER</Variable>

    <!-- StaticIf: Conditionally create debug variables at parse time -->
    <StaticIf Value="#DEBUG_MODE" Value2="1" Operation="#_conditional_eq_">
        <Variable Type="#_variable_string_" InitialValue="Debug build">BUILD_TYPE</Variable>
        <Variable Type="#_variable_double_" InitialValue="0">DEBUG_COUNTER</Variable>
    </StaticIf>

    <!-- StaticIf: Conditionally create production variables at parse time -->
    <StaticIf Value="#PRODUCTION_MODE" Value2="1" Operation="#_conditional_eq_">
        <Variable Type="#_variable_string_" InitialValue="Production build">BUILD_TYPE</Variable>
        <Variable Type="#_variable_double_" InitialValue="1">OPTIMIZE_ENABLED</Variable>
    </StaticIf>

    <Window Title="StaticIf vs If Demo" X="30" Y="30" Width="1000" Height="700">
        <Default>
            <Text Size="12" FillColor="1 1 1"/>
        </Default>

        <Panel VirtualWidth="1000" VirtualHeight="700" BackgroundColor="0.08 0.08 0.1">

            <!-- Animate counter -->
            <Set Variable="COUNTER" Operator="#_set_add_">1</Set>
            <If Value1="@COUNTER" Operation="#_conditional_gt_" Value2="100">
                <Set Variable="COUNTER" Operator="#_set_equal_">0</Set>
            </If>

            <!-- Title -->
            <Text X="500" Y="670" LocalAlignX="#_align_center_" Size="24" FillColor="1 1 1">
                StaticIf vs If Demonstration
            </Text>

            <!-- ========== LEFT SIDE: StaticIf (Parse-Time) ========== -->
            <Container X="50" Y="100" Width="450" Height="550">
                <Rectangle Width="450" Height="550" FillColor="0.12 0.12 0.15" LineColor="0.3 0.5 0.7" LineWidth="2"/>

                <Text X="225" Y="520" LocalAlignX="#_align_center_" Size="18" FillColor="0.4 0.8 1">
                    &lt;StaticIf&gt; (Parse-Time)
                </Text>

                <Text X="225" Y="490" LocalAlignX="#_align_center_" Size="11" FillColor="0.7 0.7 0.7">
                    Evaluated ONCE during XML parsing
                </Text>

                <!-- Show configuration -->
                <Text X="225" Y="450" LocalAlignX="#_align_center_" Size="14" FillColor="0.9 0.9 0.3">
                    Configuration
                </Text>

                <Text X="30" Y="420" Size="11" FillColor="0.8 0.8 0.8">
                    DEBUG_MODE = #DEBUG_MODE
                </Text>
                <Text X="30" Y="400" Size="11" FillColor="0.8 0.8 0.8">
                    PRODUCTION_MODE = #PRODUCTION_MODE
                </Text>

                <Rectangle X="30" Y="380" Width="390" Height="2" FillColor="0.3 0.5 0.7"/>

                <Text X="225" Y="350" LocalAlignX="#_align_center_" Size="14" FillColor="0.9 0.9 0.3">
                    Variables Created at Parse Time
                </Text>

                <!-- This content will only show if DEBUG_MODE was 1 at parse time -->
                <StaticIf Value="#DEBUG_MODE" Value2="1" Operation="#_conditional_eq_">
                    <Rectangle X="30" Y="250" Width="390" Height="80" FillColor="0.2 0.5 0.3"/>
                    <Text X="225" Y="315" LocalAlignX="#_align_center_" Size="12" FillColor="1 1 1">
                        DEBUG MODE ACTIVE
                    </Text>
                    <Text X="40" Y="290" Size="10" FillColor="0.9 0.9 0.9">
                        • BUILD_TYPE = @BUILD_TYPE
                    </Text>
                    <Text X="40" Y="270" Size="10" FillColor="0.9 0.9 0.9">
                        • DEBUG_COUNTER = @DEBUG_COUNTER(%.0f)
                    </Text>
                </StaticIf>

                <!-- This content will only show if PRODUCTION_MODE was 1 at parse time -->
                <StaticIf Value="#PRODUCTION_MODE" Value2="1" Operation="#_conditional_eq_">
                    <Rectangle X="30" Y="250" Width="390" Height="80" FillColor="0.5 0.2 0.2"/>
                    <Text X="225" Y="315" LocalAlignX="#_align_center_" Size="12" FillColor="1 1 1">
                        PRODUCTION MODE ACTIVE
                    </Text>
                    <Text X="40" Y="290" Size="10" FillColor="0.9 0.9 0.9">
                        • BUILD_TYPE = @BUILD_TYPE
                    </Text>
                    <Text X="40" Y="270" Size="10" FillColor="0.9 0.9 0.9">
                        • OPTIMIZE_ENABLED = @OPTIMIZE_ENABLED(%.0f)
                    </Text>
                </StaticIf>

                <!-- Explanation -->
                <Rectangle X="30" Y="210" Width="390" Height="2" FillColor="0.3 0.5 0.7"/>

                <Text X="225" Y="180" LocalAlignX="#_align_center_" Size="11" FillColor="0.6 0.8 1">
                    How it works:
                </Text>

                <Text X="40" Y="150" Size="9" FillColor="0.7 0.7 0.7">
                    1. Checks condition during XML parsing
                </Text>
                <Text X="40" Y="130" Size="9" FillColor="0.7 0.7 0.7">
                    2. Only matching branch is included
                </Text>
                <Text X="40" Y="110" Size="9" FillColor="0.7 0.7 0.7">
                    3. &lt;StaticIf&gt; disappears from scene
                </Text>
                <Text X="40" Y="90" Size="9" FillColor="0.7 0.7 0.7">
                    4. No runtime overhead
                </Text>

                <Text X="225" Y="60" LocalAlignX="#_align_center_" Size="10" FillColor="0.9 0.6 0.3">
                    ⚠ Change DEBUG_MODE/PRODUCTION_MODE
                </Text>
                <Text X="225" Y="40" LocalAlignX="#_align_center_" Size="10" FillColor="0.9 0.6 0.3">
                    and reload to see different results
                </Text>

            </Container>

            <!-- ========== RIGHT SIDE: If (Runtime) ========== -->
            <Container X="520" Y="100" Width="450" Height="550">
                <Rectangle Width="450" Height="550" FillColor="0.15 0.12 0.12" LineColor="0.7 0.3 0.5" LineWidth="2"/>

                <Text X="225" Y="520" LocalAlignX="#_align_center_" Size="18" FillColor="1 0.4 0.8">
                    &lt;If&gt; (Runtime)
                </Text>

                <Text X="225" Y="490" LocalAlignX="#_align_center_" Size="11" FillColor="0.7 0.7 0.7">
                    Evaluated EVERY FRAME during rendering
                </Text>

                <!-- Counter display -->
                <Text X="225" Y="450" LocalAlignX="#_align_center_" Size="14" FillColor="0.9 0.9 0.3">
                    Runtime Variable
                </Text>

                <Text X="30" Y="420" Size="11" FillColor="0.8 0.8 0.8">
                    COUNTER = @COUNTER(%.0f)
                </Text>

                <Rectangle X="30" Y="400" Width="390" Height="2" FillColor="0.7 0.3 0.5"/>

                <Text X="225" Y="370" LocalAlignX="#_align_center_" Size="14" FillColor="0.9 0.9 0.3">
                    Dynamic Content (Changes Every Frame)
                </Text>

                <!-- Counter status changes dynamically -->
                <If Value1="@COUNTER" Operation="#_conditional_lt_" Value2="50">
                    <Rectangle X="30" Y="290" Width="390" Height="60" FillColor="0.3 0.6 0.8"/>
                    <Text X="225" Y="325" LocalAlignX="#_align_center_" Size="14" FillColor="1 1 1">
                        COUNTER IS LOW (&lt; 50)
                    </Text>
                    <Text X="225" Y="305" LocalAlignX="#_align_center_" Size="10" FillColor="0.8 0.8 0.8">
                        This appears when COUNTER &lt; 50
                    </Text>
                </If>

                <If Value1="@COUNTER" Operation="#_conditional_gte_" Value2="50">
                    <Rectangle X="30" Y="290" Width="390" Height="60" FillColor="0.8 0.3 0.3"/>
                    <Text X="225" Y="325" LocalAlignX="#_align_center_" Size="14" FillColor="1 1 1">
                        COUNTER IS HIGH (&gt;= 50)
                    </Text>
                    <Text X="225" Y="305" LocalAlignX="#_align_center_" Size="10" FillColor="0.8 0.8 0.8">
                        This appears when COUNTER &gt;= 50
                    </Text>
                </If>

                <!-- Progress bar -->
                <Rectangle X="30" Y="260" Width="390" Height="20" FillColor="0.2 0.2 0.2" LineColor="0.4 0.4 0.4" LineWidth="1"/>
                <If Value1="@COUNTER" Operation="#_conditional_lte_" Value2="390">
                    <Rectangle X="30" Y="260" Width="@COUNTER" Height="20" FillColor="0.3 0.8 0.5"/>
                </If>

                <!-- Explanation -->
                <Rectangle X="30" Y="220" Width="390" Height="2" FillColor="0.7 0.3 0.5"/>

                <Text X="225" Y="190" LocalAlignX="#_align_center_" Size="11" FillColor="1 0.6 0.8">
                    How it works:
                </Text>

                <Text X="40" Y="160" Size="9" FillColor="0.7 0.7 0.7">
                    1. Creates conditional node in scene graph
                </Text>
                <Text X="40" Y="140" Size="9" FillColor="0.7 0.7 0.7">
                    2. Evaluates condition every frame
                </Text>
                <Text X="40" Y="120" Size="9" FillColor="0.7 0.7 0.7">
                    3. Dynamically shows/hides content
                </Text>
                <Text X="40" Y="100" Size="9" FillColor="0.7 0.7 0.7">
                    4. Responds to runtime variable changes
                </Text>

                <Text X="225" Y="70" LocalAlignX="#_align_center_" Size="10" FillColor="1 0.8 0.4">
                    Watch the box and bar change in real-time!
                </Text>

            </Container>

            <!-- Bottom explanation -->
            <Container X="50" Y="20" Width="920" Height="60">
                <Rectangle Width="920" Height="60" FillColor="0.15 0.15 0.2" LineColor="0.5 0.5 0.6" LineWidth="1"/>
                <Text X="460" Y="45" LocalAlignX="#_align_center_" Size="11" FillColor="0.9 0.9 1">
                    Key Difference: &lt;StaticIf&gt; = Parse-time (evaluated once) | &lt;If&gt; = Runtime (evaluated every frame)
                </Text>
                <Text X="460" Y="25" LocalAlignX="#_align_center_" Size="9" FillColor="0.7 0.7 0.8">
                    Use &lt;StaticIf&gt; for: Config setup, conditional variable registration, TrickIO selection
                </Text>
                <Text X="460" Y="10" LocalAlignX="#_align_center_" Size="9" FillColor="0.7 0.7 0.8">
                    Use &lt;If&gt; for: Dynamic UI, sensor displays, user interaction responses
                </Text>
            </Container>

        </Panel>
    </Window>
</DCAPP>
